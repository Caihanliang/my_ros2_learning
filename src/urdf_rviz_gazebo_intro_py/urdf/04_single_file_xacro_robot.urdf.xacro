<?xml version="1.0"?>
<robot name="single_file_xacro_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- property：给重复使用的数字命名。 -->
  <xacro:property name="base_length" value="0.55"/>
  <xacro:property name="base_width" value="0.38"/>
  <xacro:property name="base_height" value="0.16"/>
  <xacro:property name="base_link_z" value="0.16"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_x" value="0.08"/>
  <xacro:property name="wheel_joint_z" value="-0.06"/>

  <xacro:property name="caster_radius" value="0.05"/>
  <xacro:property name="lidar_support_length" value="0.08"/>
  <xacro:property name="lidar_radius" value="0.065"/>
  <xacro:property name="lidar_height" value="0.055"/>

  <!-- 材质暂时仍然留在这个文件中。 -->
  <material name="course_blue"><color rgba="0.12 0.35 0.90 1.0"/></material>
  <material name="wheel_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
  <material name="caster_gray"><color rgba="0.55 0.55 0.55 1.0"/></material>
  <material name="sensor_dark"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="support_gray"><color rgba="0.35 0.35 0.38 1.0"/></material>
  <material name="marker_yellow"><color rgba="0.95 0.75 0.10 1.0"/></material>

  <!-- macro：把左右轮重复结构写成一个模板。 -->
  <xacro:macro name="wheel" params="side y_position">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <visual name="rotation_marker">
        <origin xyz="${wheel_radius} 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.07 0.025"/></geometry>
        <material name="marker_yellow"/>
      </visual>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${y_position} ${wheel_joint_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="course_blue"/>
    </visual>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <!-- 调用同一个宏两次，生成左右轮。 -->
  <xacro:wheel side="left" y_position="0.22"/>
  <xacro:wheel side="right" y_position="-0.22"/>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="caster_gray"/>
    </visual>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.24 0 -0.11" rpy="0 0 0"/>
  </joint>

  <link name="lidar_support_link">
    <visual>
      <geometry><cylinder radius="0.025" length="${lidar_support_length}"/></geometry>
      <material name="support_gray"/>
    </visual>
  </link>
  <joint name="lidar_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_support_link"/>
    <origin xyz="0.16 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="sensor_dark"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_support_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>
</robot>