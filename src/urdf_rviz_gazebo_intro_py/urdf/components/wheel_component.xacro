<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_marker_width" value="0.07"/>
  <xacro:property name="wheel_x" value="0.08"/>
  <xacro:property name="wheel_joint_z" value="-0.06"/>

  <xacro:macro name="wheel_component" params="side y_position with_physics">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="${side}_wheel_black">
          <color rgba="0.03 0.03 0.03 1.0"/>
        </material>
      </visual>

      <visual name="rotation_marker">
        <origin xyz="${wheel_radius} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 ${wheel_marker_width} 0.025"/>
        </geometry>
        <material name="${side}_marker_yellow">
          <color rgba="0.95 0.75 0.10 1.0"/>
        </material>
      </visual>

      <xacro:if value="${with_physics}">
        <collision>
          <origin xyz="0 0 0" rpy="1.5708 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          </geometry>
        </collision>
        <inertial>
          <mass value="0.45"/>
          <inertia ixx="0.00126" ixy="0.0" ixz="0.0"
                   iyy="0.00225" iyz="0.0" izz="0.00126"/>
        </inertial>
      </xacro:if>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${y_position} ${wheel_joint_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
</robot>