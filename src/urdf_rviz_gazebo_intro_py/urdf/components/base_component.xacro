<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 车体需要的参数就在车体文件里。 -->
  <xacro:property name="base_length" value="0.55"/>
  <xacro:property name="base_width" value="0.38"/>
  <xacro:property name="base_height" value="0.16"/>
  <xacro:property name="base_link_z" value="0.16"/>

  <xacro:macro name="base_component" params="with_physics">
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <!-- 颜色也直接留在车体组件中。 -->
        <material name="base_blue">
          <color rgba="0.12 0.35 0.90 1.0"/>
        </material>
      </visual>

      <xacro:if value="${with_physics}">
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <box size="${base_length} ${base_width} ${base_height}"/>
          </geometry>
        </collision>
        <inertial>
          <origin xyz="-0.04 0 0" rpy="0 0 0"/>
          <mass value="5.0"/>
          <inertia ixx="0.0708" ixy="0.0" ixz="0.0"
                   iyy="0.1367" iyz="0.0" izz="0.1862"/>
        </inertial>
      </xacro:if>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>