<?xml version="1.0"?>
<robot name="modular_xacro_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="components/base_footprint_component.xacro"/>
  <xacro:include filename="components/base_component.xacro"/>
  <xacro:include filename="components/wheel_component.xacro"/>
  <xacro:include filename="components/caster_component.xacro"/>
  <xacro:include filename="components/lidar_component.xacro"/>

  <xacro:base_footprint_component/>
  <xacro:base_component/>
  <xacro:wheel_component side="left" y_position="0.22"/>
  <xacro:wheel_component side="right" y_position="-0.22"/>
  <xacro:caster_component/>
  <xacro:lidar_component/>
</robot>